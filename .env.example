MP_API_KEY = ###

OLLAMA_BASE_URL = http://localhost:11434/v1
OLLAMA_API_KEY = ollama
OLLAMA_MODEL = gemma4:latest

MLFLOW_TRACKING_URI = sqlite:///mlflow.db

# Campaign configuration
INITIAL_BUDGET = 100.0          # Total budget for the campaign (in arbitrary units)
MAX_EXPERIMENTS = 10            # Maximum number of experiments allowed

# Critic thresholds
STABILITY_THRESHOLD = 0.05           # Energy above hull threshold (eV/atom) - materials exceeding this are rejected
FORCE_GATE_EV_PER_ANG = 0.5          # Force threshold - predictions with force > this are flagged

MACE_CHECKPOINT = mace-mpa-0-medium  # Default MACE checkpoint for property predictions